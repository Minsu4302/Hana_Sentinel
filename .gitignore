# ── Claude Code 개인 설정 ──
.claude/settings.local.json

# ── 비밀값 (N7) — 토큰은 환경변수로만 ──
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets/
credentials*

# ── 캡처물·원본 트래픽 (N5·N7, (A) §1.3 ⓕ) ──
# 주의: .gitignore는 커밋만 막을 뿐 디스크 쓰기를 막지 못한다(R-10). 원본 미기록은 기능 부재 + 테스트로 보장.
captures/
*.har
*.burp
*.saz
*.pcap
*.pcapng
traffic/
raw/

# ── 생성물·캐시 ──
# manifest/capability_manifest.json은 의도적으로 커밋한다(재파생 일치 검증 대상).
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
build/
dist/
*.egg-info/
.coverage
htmlcov/
*.log

# ── 편집기 ──
.vscode/
.idea/

# ── 감사 저장소(로컬 SQLite) ──
var/
*.sqlite3
